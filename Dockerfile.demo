# syntax=docker/dockerfile:1
FROM node:22-alpine AS assets
WORKDIR /app
COPY package.json package-lock.json ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/proxy_ca; fi; \
    npm ci --no-audit --no-fund
COPY vite.config.js tailwind.config.js postcss.config.js ./
COPY resources ./resources
RUN npm run build

FROM composer:2.8
WORKDIR /app
COPY composer.json composer.lock ./
RUN --mount=type=secret,id=proxy_ca \
    if [ -f /run/secrets/proxy_ca ]; then export COMPOSER_CAFILE=/run/secrets/proxy_ca; fi; \
    composer install --no-dev --no-scripts --no-interaction --prefer-dist
COPY --chown=10001:10001 . .
COPY --from=assets --chown=10001:10001 /app/public/build ./public/build
RUN mkdir -p storage/demo storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs \
    && composer dump-autoload --no-dev --optimize \
    && adduser -D -u 10001 hris \
    && chown -R hris:hris storage bootstrap/cache
USER hris
ENV APP_NAME="HRIS Demo" APP_ENV=local APP_DEBUG=false APP_URL=http://localhost:8000 \
    HRIS_DEMO=true DB_CONNECTION=sqlite DB_DATABASE=/app/storage/demo/database.sqlite \
    SESSION_DRIVER=file CACHE_STORE=file QUEUE_CONNECTION=sync MAIL_MAILER=log LOG_CHANNEL=single
EXPOSE 8000
ENTRYPOINT ["sh", "/app/scripts/start-demo.sh"]
